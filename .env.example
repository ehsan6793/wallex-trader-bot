# این فایل را کپی کنید با نام .env و کلید را جلوی WALLEX_API_KEY= بگذارید. فایل .env هرگز در گیت قرار نمی‌گیرد.
WALLEX_API_KEY=
# زمان پایان رسمی چالش (به وقت تهران). ربات ۹۰ دقیقه قبلش ورود جدید ندارد و ۲۰ دقیقه قبلش همه‌چیز را به تومان می‌فروشد.
CHALLENGE_END=2026-10-23T13:30:00+03:30
# اختیاری: ناظر ریسک LLM (هر API سازگار با OpenAI، مثلاً Metis)
LLM_API_KEY=
LLM_BASE_URL=https://api.metisai.ir/openai/v1
LLM_MODEL=gpt-4o
